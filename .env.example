# -----------------------------------------------------------------------------
# CBT-PPLG ENVIRONMENT CONFIGURATION
# -----------------------------------------------------------------------------

# 1. Groq Cloud API (AI Tutor & Pembuat Soal Adaptif CBT-PPLG)
ROUTER_API_BASE=https://api.groq.com/openai/v1
ROUTER_API_KEY=your_groq_api_key_here
ROUTER_MODEL=openai/gpt-oss-120b

# 2. TiDB Serverless Database (MySQL 8.0 Cloud Compatible)
# Dapatkan connection string gratis di https://tidbcloud.com (Free Tier 5GB)
DATABASE_URL=mysql://<username>:<password>@gateway01.<region>.prod.aws.tidbcloud.com:4000/<database_name>?ssl={"rejectUnauthorized":true}

# Alternatif parameter terpisah (jika tidak menggunakan URL):
# TIDB_HOST=gateway01.<region>.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=<username>
# TIDB_PASSWORD=<password>
# TIDB_DATABASE=cbt_pplg

# 3. Master Passkey Admin (Opsional, bawaan: 3j3nkf9sfcajna3982)
# ADMIN_MASTER_PASSKEY=3j3nkf9sfcajna3982
